# Copy to gateway.env and fill in. gateway.env is gitignored; this file is not, so it must
# never contain a real value.
#
#     cp gateway.env.example gateway.env && chmod 600 gateway.env
#
# Grammar (see src/mcp_gateway/secrets.md — it is small, and it will not change):
#
#   KEY=value                 raw to end of line, then stripped
#   KEY='literal'             no escapes at all
#   KEY="with\ttabs"          \n \t \r \\ \" decoded
#   export KEY=value          the `export ` is stripped, for pasting from a shell
#
#   * `#` is a legal character inside an unquoted value: KEY=abc#def is `abc#def`.
#     There is no inline comment stripping. Quote the value if you want one.
#   * A duplicate key is an ERROR naming both lines, not a silent last-wins — that is how a
#     freshly rotated credential gets shadowed by a stale one further up the file.
#   * An empty value is present, not missing.
#   * There is no interpolation inside this file. ${NAME} is resolved in servers.yaml only.

# The daemon's own access key. Required to bind anything but loopback; strongly recommended
# even on loopback, since another local account could otherwise open a connection and reach
# every backend below. Generate one with:
#
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# MCP_GATEWAY_WS_KEY in the environment overrides this. Note that `make run` always
# exports one -- reusing the environment's, else minting a fresh key for that run and
# printing it in the banner -- so this line is what a daemon started *directly* uses:
# under launchd, in a container, or anywhere there is no banner to read a key off.
WS_ACCESS_KEY=

# Referenced by servers.yaml. Delete the ones you do not use.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
POSTGRES_URL=
