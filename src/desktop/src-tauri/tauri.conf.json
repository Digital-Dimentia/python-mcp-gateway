{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP-Gateway",
  "version": "0.1.0",
  "identifier": "com.dbuschman7.mcp-gateway",
  "build": {
    "frontendDist": "../.staging/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCP Gateway",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python",
      "seed": "seed"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
